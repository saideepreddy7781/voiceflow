<Project>
  <PropertyGroup>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <Version>0.1.0</Version>
    <Product>VoiceFlow</Product>
    <Company>Saideep Reddy</Company>
    <Authors>Saideep Reddy</Authors>
    <Copyright>Copyright (c) 2026 Saideep Reddy</Copyright>
    <Deterministic>true</Deterministic>
    <!-- Symbols inside the assemblies, so a single-file publish is one VoiceFlow.exe. -->
    <DebugType>embedded</DebugType>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>
</Project>
