<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>VoiceFlow.Windows</RootNamespace>
    <AssemblyName>VoiceFlow</AssemblyName>
    <ApplicationIcon>Assets\VoiceFlow.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- DPI awareness is declared in app.manifest (Per-Monitor V2) so it applies before any code runs. -->
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <AssemblyTitle>VoiceFlow</AssemblyTitle>
    <Description>Voice dictation for Windows: hold a hotkey, speak, and clean text is typed where you are.</Description>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Single-file publish settings (the flags are also passed on the command line in CI). -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <!-- Audio capture (WASAPI microphone and loopback). MIT licensed. -->
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <!-- Session lock and resume notifications for the keyboard hook. MIT licensed. -->
    <PackageReference Include="Microsoft.Win32.SystemEvents" Version="8.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\VoiceFlow.Core\VoiceFlow.Core.csproj" />
    <ProjectReference Include="..\VoiceFlow.Desktop\VoiceFlow.Desktop.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Assets\VoiceFlow.ico" LogicalName="VoiceFlow.ico" />
  </ItemGroup>
  <Import Project="..\VoiceFlow.Desktop\MSBuild\NoAvaloniaGenerators.targets" />
  <!-- SkiaSharp and HarfBuzz ship 100 MB of native .pdb files next to their DLLs; managed symbols are embedded already. -->
  <Target Name="DropNativeSymbolsFromPublish" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>
</Project>
