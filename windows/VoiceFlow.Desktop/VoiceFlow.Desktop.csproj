<Project Sdk="Microsoft.NET.Sdk">
  <!-- The Avalonia UI, as a library that VoiceFlow.Windows hosts. It has no Windows-only code, so it builds and renders anywhere. -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>VoiceFlow.Desktop</RootNamespace>
    <AssemblyName>VoiceFlow.Desktop</AssemblyName>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <AssemblyTitle>VoiceFlow</AssemblyTitle>
    <Description>Voice dictation for Windows: hold a hotkey, speak, and clean text is typed where you are.</Description>
  </PropertyGroup>
  <ItemGroup>
    <!-- All MIT licensed. Versions are pinned; bump them together. -->
    <PackageReference Include="Avalonia" Version="12.1.6" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.6" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.6" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\VoiceFlow.Core\VoiceFlow.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>
  <Import Project="..\VoiceFlow.Desktop\MSBuild\NoAvaloniaGenerators.targets" />
</Project>
