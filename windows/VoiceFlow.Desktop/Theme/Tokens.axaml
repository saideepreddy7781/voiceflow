<!-- Design tokens: one monochrome palette per theme, one accent (Signal) reserved for recording and attention. -->
<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="WindowBg" Color="#151515"/>
      <SolidColorBrush x:Key="SidebarBg" Color="#0F0F0F"/>
      <SolidColorBrush x:Key="Surface" Color="#1C1C1C"/>
      <SolidColorBrush x:Key="SurfaceRaised" Color="#232323"/>
      <SolidColorBrush x:Key="SurfaceInset" Color="#151515"/>
      <SolidColorBrush x:Key="Hairline" Color="#1FFFFFFF"/>
      <SolidColorBrush x:Key="HairlineStrong" Color="#38FFFFFF"/>
      <SolidColorBrush x:Key="Fg" Color="#F2F2F2"/>
      <SolidColorBrush x:Key="FgMuted" Color="#A3A3A3"/>
      <SolidColorBrush x:Key="FgSubtle" Color="#8A8A8A"/>
      <SolidColorBrush x:Key="HoverFill" Color="#14FFFFFF"/>
      <SolidColorBrush x:Key="PressedFill" Color="#0CFFFFFF"/>
      <SolidColorBrush x:Key="SelectedFill" Color="#1CFFFFFF"/>
      <SolidColorBrush x:Key="FocusRing" Color="#D9FFFFFF"/>
      <SolidColorBrush x:Key="Primary" Color="#F2F2F2"/>
      <SolidColorBrush x:Key="PrimaryHover" Color="#FFFFFF"/>
      <SolidColorBrush x:Key="PrimaryPressed" Color="#D1D1D1"/>
      <SolidColorBrush x:Key="OnPrimary" Color="#0F0F0F"/>
      <SolidColorBrush x:Key="Signal" Color="#F2613F"/>
      <SolidColorBrush x:Key="SignalSoft" Color="#26F2613F"/>
      <SolidColorBrush x:Key="Track" Color="#2B2B2B"/>
      <SolidColorBrush x:Key="MeterFill" Color="#F2F2F2"/>
      <SolidColorBrush x:Key="Scrim" Color="#99000000"/>
      <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#232323"/>
      <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="#38FFFFFF"/>
      <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="#232323"/>
      <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush" Color="#38FFFFFF"/>
      <Color x:Key="Heat0">#2A2A2A</Color>
      <Color x:Key="Heat1">#4D4D4D</Color>
      <Color x:Key="Heat2">#808080</Color>
      <Color x:Key="Heat3">#B8B8B8</Color>
      <Color x:Key="Heat4">#F2F2F2</Color>
    </ResourceDictionary>
    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="WindowBg" Color="#FAFAFA"/>
      <SolidColorBrush x:Key="SidebarBg" Color="#F1F1F1"/>
      <SolidColorBrush x:Key="Surface" Color="#FFFFFF"/>
      <SolidColorBrush x:Key="SurfaceRaised" Color="#FFFFFF"/>
      <SolidColorBrush x:Key="SurfaceInset" Color="#F5F5F5"/>
      <SolidColorBrush x:Key="Hairline" Color="#1A000000"/>
      <SolidColorBrush x:Key="HairlineStrong" Color="#33000000"/>
      <SolidColorBrush x:Key="Fg" Color="#161616"/>
      <SolidColorBrush x:Key="FgMuted" Color="#5C5C5C"/>
      <SolidColorBrush x:Key="FgSubtle" Color="#737373"/>
      <SolidColorBrush x:Key="HoverFill" Color="#0D000000"/>
      <SolidColorBrush x:Key="PressedFill" Color="#14000000"/>
      <SolidColorBrush x:Key="SelectedFill" Color="#12000000"/>
      <SolidColorBrush x:Key="FocusRing" Color="#CC000000"/>
      <SolidColorBrush x:Key="Primary" Color="#161616"/>
      <SolidColorBrush x:Key="PrimaryHover" Color="#2E2E2E"/>
      <SolidColorBrush x:Key="PrimaryPressed" Color="#000000"/>
      <SolidColorBrush x:Key="OnPrimary" Color="#FFFFFF"/>
      <SolidColorBrush x:Key="Signal" Color="#CF3A1A"/>
      <SolidColorBrush x:Key="SignalSoft" Color="#1FCF3A1A"/>
      <SolidColorBrush x:Key="Track" Color="#E8E8E8"/>
      <SolidColorBrush x:Key="MeterFill" Color="#161616"/>
      <SolidColorBrush x:Key="Scrim" Color="#40000000"/>
      <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#FFFFFF"/>
      <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="#26000000"/>
      <SolidColorBrush x:Key="MenuFlyoutPresenterBackground" Color="#FFFFFF"/>
      <SolidColorBrush x:Key="MenuFlyoutPresenterBorderBrush" Color="#26000000"/>
      <Color x:Key="Heat0">#EBEBEB</Color>
      <Color x:Key="Heat1">#C4C4C4</Color>
      <Color x:Key="Heat2">#8F8F8F</Color>
      <Color x:Key="Heat3">#555555</Color>
      <Color x:Key="Heat4">#161616</Color>
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>

  <!-- Fonts. Segoe UI Variable picks optical sizes per family name. Nirmala UI carries Telugu and Devanagari; the rest are fallbacks on older Windows and macOS. -->
  <FontFamily x:Key="FontText">Segoe UI Variable Text, Segoe UI, Nirmala UI, Helvetica Neue, Arial</FontFamily>
  <FontFamily x:Key="FontDisplay">Segoe UI Variable Display, Segoe UI, Nirmala UI, Helvetica Neue, Arial</FontFamily>
  <FontFamily x:Key="FontMono">Cascadia Mono, Cascadia Code, Consolas, Menlo, monospace</FontFamily>

  <!-- 8 px rhythm. 12 is the one half step, used inside controls. -->
  <CornerRadius x:Key="OverlayCornerRadius">8</CornerRadius>
  <CornerRadius x:Key="RadiusControl">6</CornerRadius>
  <CornerRadius x:Key="RadiusCard">12</CornerRadius>
  <CornerRadius x:Key="RadiusPill">999</CornerRadius>
  <Thickness x:Key="PagePadding">40,16,40,40</Thickness>
  <Thickness x:Key="CardPadding">24</Thickness>
</ResourceDictionary>
