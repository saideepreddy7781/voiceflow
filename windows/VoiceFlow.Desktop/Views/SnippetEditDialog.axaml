<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VoiceFlow.Desktop.ViewModels"
             x:Class="VoiceFlow.Desktop.Views.SnippetEditDialog"
             x:DataType="vm:SnippetEditViewModel">
  <Border Classes="card" Width="480" Padding="24" BoxShadow="0 8 24 0 #33000000">
    <StackPanel Spacing="16">
      <TextBlock Text="{Binding Heading}" Classes="h2"/>
      <StackPanel Spacing="4">
        <TextBlock Text="Cue" Classes="caption subtle"/>
        <TextBox Text="{Binding Trigger}" PlaceholderText="my calendar link" AutomationProperties.Name="Cue"/>
      </StackPanel>
      <StackPanel Spacing="4">
        <TextBlock Text="Text to type" Classes="caption subtle"/>
        <TextBox Text="{Binding Expansion}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="96" VerticalContentAlignment="Top" AutomationProperties.Name="Text to type"/>
      </StackPanel>
      <TextBlock Text="{Binding Error}" Classes="callout wrap" Foreground="{DynamicResource Signal}" IsVisible="{Binding HasError}"/>
      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
        <Button Content="Cancel" Command="{Binding CancelCommand}" IsCancel="True"/>
        <Button Classes="primary" Content="Save" Command="{Binding SaveCommand}" IsDefault="True"/>
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
