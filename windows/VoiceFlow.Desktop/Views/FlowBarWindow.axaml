<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:VoiceFlow.Desktop.ViewModels"
        xmlns:v="using:VoiceFlow.Desktop.Views"
        x:Class="VoiceFlow.Desktop.Views.FlowBarWindow"
        x:DataType="vm:FlowBarViewModel"
        Title="VoiceFlow bar"
        WindowDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent" TransparencyBackgroundFallback="Transparent"
        Topmost="True" ShowInTaskbar="False" CanResize="False" ShowActivated="False"
        SizeToContent="WidthAndHeight">
  <!-- VoiceFlow.Windows applies WS_EX_NOACTIVATE and clips the window to the bar's shape on the native handle.
       The padding leaves room for the anti-aliased edge outside that shape; nothing is drawn there. -->
  <v:FlowBarView Padding="3"/>
</Window>
