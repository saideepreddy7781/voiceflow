<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VoiceFlow.Desktop.ViewModels"
             xmlns:c="using:VoiceFlow.Desktop.Controls"
             x:Class="VoiceFlow.Desktop.Views.FlowBarView"
             x:DataType="vm:FlowBarViewModel"
             Background="Transparent">
  <UserControl.Styles>
    <!-- The bar is always white on black, in both themes. -->
    <Style Selector="Border.barFill">
      <Setter Property="Background" Value="#161616"/>
      <Setter Property="BorderBrush" Value="#29FFFFFF"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style Selector="Button.barRound">
      <Setter Property="Width" Value="22"/>
      <Setter Property="Height" Value="22"/>
      <Setter Property="MinHeight" Value="22"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="CornerRadius" Value="11"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="Button.barGhost">
      <Setter Property="Background" Value="#59FFFFFF"/>
      <Setter Property="Foreground" Value="#FFFFFF"/>
    </Style>
    <Style Selector="Button.barIdle">
      <Setter Property="Background" Value="#161616"/>
      <Setter Property="BorderBrush" Value="#29FFFFFF"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="12,4"/>
      <Setter Property="MinHeight" Value="24"/>
    </Style>
    <Style Selector="Button.barChip">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="11"/>
      <Setter Property="Padding" Value="4,2"/>
      <Setter Property="MinHeight" Value="22"/>
    </Style>
    <Style Selector="Button.barChip:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#1FFFFFFF"/>
    </Style>
    <Style Selector="Button.barPrimary">
      <Setter Property="Background" Value="#FFFFFF"/>
      <Setter Property="Foreground" Value="#000000"/>
    </Style>
  </UserControl.Styles>
  <StackPanel Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Bottom">
    <!-- Toast -->
    <Border Classes="barFill barHit" CornerRadius="12" MaxWidth="420" Padding="14,9" IsVisible="{Binding ShowToast}" HorizontalAlignment="Center">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="2" VerticalAlignment="Center">
          <TextBlock Text="{Binding ToastMessage}" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF" TextWrapping="Wrap"/>
          <TextBlock Text="{Binding ToastDetail}" FontSize="11" Foreground="#BFFFFFFF" TextWrapping="Wrap" IsVisible="{Binding HasToastDetail}"/>
        </StackPanel>
        <Button Grid.Column="1" Classes="primary" Margin="12,0,0,0" MinHeight="24" Padding="10,3" FontSize="12"
                Background="#FFFFFF" Foreground="#000000" Content="{Binding ToastActionTitle}"
                Command="{Binding RunToastActionCommand}" IsVisible="{Binding HasToastAction}"/>
      </Grid>
    </Border>

    <!-- Pill -->
    <Border Classes="barFill" CornerRadius="16" Padding="8,0" MinHeight="32" HorizontalAlignment="Center" IsVisible="{Binding ShowPill}"
            BoxShadow="0 2 8 0 #40000000">
      <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <Button Classes="barRound barGhost" Command="{Binding CancelCommand}" IsVisible="{Binding ShowHandsFree}"
                ToolTip.Tip="Cancel (Esc)" AutomationProperties.Name="Cancel dictation">
          <PathIcon Data="{StaticResource IconDismiss}" Width="10" Height="10"/>
        </Button>
        <PathIcon Data="{StaticResource IconSparkle}" Width="14" Height="14" Foreground="#FFFFFF" IsVisible="{Binding IsCommand}"/>
        <c:WaveBars Levels="{Binding Levels}" Frozen="{Binding Frozen}" Fill="#F7F7F7" Height="22" VerticalAlignment="Center"/>
        <Button Classes="barRound barPrimary" Command="{Binding ConfirmCommand}" IsVisible="{Binding ShowHandsFree}"
                ToolTip.Tip="Finish" AutomationProperties.Name="Finish dictation">
          <PathIcon Data="{StaticResource IconCheckmark}" Width="11" Height="11"/>
        </Button>
      </StackPanel>
    </Border>

    <!-- Resting pill, only with "Show Flow bar at all times" on. A click starts hands-free dictation. -->
    <Button Classes="barIdle" Command="{Binding StartHandsFreeCommand}" IsVisible="{Binding ShowIdlePill}" HorizontalAlignment="Center"
            ToolTip.Tip="Start hands-free dictation" AutomationProperties.Name="Start hands-free dictation">
      <c:WaveBars Fill="#99FFFFFF" Height="14" BarCount="7" VerticalAlignment="Center"/>
    </Button>

    <!-- Recording chip while Notetaker runs -->
    <Border Classes="barFill" CornerRadius="16" Padding="8,0,4,0" MinHeight="30" HorizontalAlignment="Center" IsVisible="{Binding ShowMeetingChip}"
            BorderBrush="#7FF2613F">
      <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <Button Classes="barChip" Command="{Binding OpenMeetingsCommand}" ToolTip.Tip="Open Meetings" AutomationProperties.Name="Open the Meetings page">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Ellipse Classes="recdot"/>
            <TextBlock Text="{Binding MeetingClock}" FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFF" VerticalAlignment="Center"/>
            <TextBlock Text="Notetaker" FontSize="11" Foreground="#B3FFFFFF" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>
        <Button Classes="barRound barPrimary" Command="{Binding StopMeetingCommand}" ToolTip.Tip="Stop and write notes" AutomationProperties.Name="Stop recording and write notes">
          <Border Classes="stopGlyph" Width="8" Height="8" Background="#000000"/>
        </Button>
      </StackPanel>
    </Border>
  </StackPanel>
</UserControl>
