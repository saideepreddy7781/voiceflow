<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VoiceFlow.Desktop.ViewModels"
             xmlns:c="using:VoiceFlow.Desktop.Controls"
             x:Class="VoiceFlow.Desktop.Views.HelpPage"
             x:DataType="vm:HelpViewModel">
  <ScrollViewer>
    <StackPanel Spacing="24" MaxWidth="760" Margin="{DynamicResource PagePadding}">
      <StackPanel Spacing="4">
        <TextBlock Text="Help" Classes="title"/>
        <TextBlock Text="The shortcuts, and a few things worth trying." Classes="body muted"/>
      </StackPanel>
      <Border Classes="card" Padding="24,12">
        <StackPanel Classes="rows">
          <c:SettingRow Title="Dictate (hold)">
            <Border Classes="keycap"><TextBlock Text="{Binding Hotkey}"/></Border>
          </c:SettingRow>
          <c:SettingRow Title="Hands-free">
            <Border Classes="keycap"><TextBlock Text="{Binding HandsFree}"/></Border>
          </c:SettingRow>
          <c:SettingRow Title="Command Mode">
            <Border Classes="keycap"><TextBlock Text="{Binding Command}"/></Border>
          </c:SettingRow>
          <c:SettingRow Title="Paste last transcript">
            <Border Classes="keycap"><TextBlock Text="Alt + Shift + V"/></Border>
          </c:SettingRow>
          <c:SettingRow Title="Scratchpad">
            <Border Classes="keycap"><TextBlock Text="Alt + Shift + S"/></Border>
          </c:SettingRow>
          <c:SettingRow Title="Cancel">
            <Border Classes="keycap"><TextBlock Text="Esc"/></Border>
          </c:SettingRow>
        </StackPanel>
      </Border>
      <StackPanel Spacing="10">
        <TextBlock Text="Tips" Classes="h3"/>
        <TextBlock Classes="body muted wrap" Text="Correct yourself out loud. Say Tuesday, no actually Wednesday, and VoiceFlow types Wednesday."/>
        <TextBlock Classes="body muted wrap" Text="Say new line, new paragraph, comma or question mark when you want them exactly."/>
        <TextBlock Classes="body muted wrap" Text="Select text, hold the Command Mode keys and say make this more formal or translate to Hindi."/>
        <TextBlock Classes="body muted wrap" Text="Nothing typed? Paste your last transcript with Alt + Shift + V."/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="Documentation" Command="{Binding OpenDocsCommand}"/>
        <Button Content="Report an issue" Command="{Binding ReportIssueCommand}"/>
      </StackPanel>
      <TextBlock Text="{Binding Version}" Classes="caption subtle"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
