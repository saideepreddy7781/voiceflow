<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:VoiceFlow.Desktop.ViewModels"
             x:Class="VoiceFlow.Desktop.Views.ConfirmDialog"
             x:DataType="vm:ConfirmDialogViewModel">
  <Border Classes="card" Width="440" Padding="24" BoxShadow="0 16 48 0 #55000000">
    <StackPanel Spacing="16">
      <TextBlock Text="{Binding Title}" Classes="h2 wrap"/>
      <TextBlock Text="{Binding Message}" Classes="callout muted wrap"/>
      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
        <Button Content="Cancel" Command="{Binding CancelCommand}" IsCancel="True"/>
        <Button Classes="signal" Content="{Binding ConfirmLabel}" Command="{Binding ConfirmCommand}" IsDefault="True"/>
      </StackPanel>
    </StackPanel>
  </Border>
</UserControl>
